# Storage backend options: filesystem, google_sheets, both
BHUMI_STORAGE_BACKEND="google_sheets"

# Replace with the actual Google Sheet ID from the sheet URL.
BHUMI_GOOGLE_SHEETS_SPREADSHEET_ID="your-spreadsheet-id"

# Required for Google Sheets API writes. Use either a path to the JSON file
# or the raw service-account JSON object.
BHUMI_GOOGLE_SERVICE_ACCOUNT_JSON="/absolute/path/to/service-account.json"
